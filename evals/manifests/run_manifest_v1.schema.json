{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodePilot Shared Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "git_sha", "dataset_id", "dataset_sha256", "split",
    "model_id", "prompt_sha", "tool_schema_sha", "runtime_digest", "max_steps", "max_tokens",
    "scorer_sha", "gold_source", "cost_usd_estimate", "run_id", "trace_id", "started_at",
    "ended_at", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "CodePilot"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"$ref": "#/$defs/nullableSha256"},
    "split": {"type": "string", "minLength": 1},
    "model_id": {"const": "scripted-oracle"},
    "prompt_sha": {"$ref": "#/$defs/nullableSha256"},
    "tool_schema_sha": {"$ref": "#/$defs/nullableSha256"},
    "runtime_digest": {"$ref": "#/$defs/nullableSha256"},
    "max_steps": {"type": ["integer", "null"], "minimum": 0},
    "max_tokens": {"type": ["integer", "null"], "minimum": 0},
    "scorer_sha": {"$ref": "#/$defs/nullableSha256"},
    "gold_source": {"type": "string", "minLength": 1},
    "cost_usd_estimate": {"type": "number", "minimum": 0},
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "failed", "blocked", "cancelled"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }
}
