{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"CodePilot Run Manifest v1","type":"object","additionalProperties":false,"required":["schema_version","run_id","git_sha","dataset_id","dataset_sha256","split","model_id","prompt_sha256","tool_schema_sha256","scorer_sha256","runtime","budget","gold_source","cost_usd","started_at","finished_at","status"],"properties":{"schema_version":{"const":1},"run_id":{"type":"string","minLength":1},"git_sha":{"$ref":"#/$defs/sha"},"dataset_id":{"type":"string","minLength":1},"dataset_sha256":{"$ref":"#/$defs/sha"},"split":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"prompt_sha256":{"$ref":"#/$defs/sha"},"tool_schema_sha256":{"$ref":"#/$defs/sha"},"scorer_sha256":{"$ref":"#/$defs/sha"},"runtime":{"type":"string","minLength":1},"budget":{"type":"object","required":["max_cost_usd","max_tokens"],"properties":{"max_cost_usd":{"type":"number","minimum":0},"max_tokens":{"type":"integer","minimum":1}},"additionalProperties":false},"gold_source":{"type":"string","minLength":1},"cost_usd":{"type":["number","null"],"minimum":0},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":["string","null"]},"status":{"enum":["fixture","running","success","failed","blocked","cancelled"]}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
