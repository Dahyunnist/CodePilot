{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodePilot Live Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "git_sha", "dataset_id", "dataset_sha256",
    "split", "model_id", "prompt_sha", "tool_schema_sha", "runtime_digest",
    "max_steps", "max_tokens", "scorer_sha", "gold_source", "cost_usd_estimate",
    "cost_certainty", "request_attempt_count", "response_count", "failed_request_count",
    "case_count", "completed_case_count", "failed_case_count", "run_id", "trace_id",
    "started_at", "ended_at", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "CodePilot"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "split": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "prompt_sha": {"$ref": "#/$defs/sha256"},
    "tool_schema_sha": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "runtime_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "max_steps": {"type": "integer", "minimum": 0},
    "max_tokens": {"type": "integer", "minimum": 0},
    "scorer_sha": {"$ref": "#/$defs/sha256"},
    "gold_source": {"type": "string", "minLength": 1},
    "cost_usd_estimate": {"type": ["number", "null"], "minimum": 0},
    "cost_certainty": {"enum": ["unknown", "estimated_from_reported_usage", "observed_zero_requests"]},
    "request_attempt_count": {"type": "integer", "minimum": 0},
    "response_count": {"type": "integer", "minimum": 0},
    "failed_request_count": {"type": "integer", "minimum": 0},
    "case_count": {"type": "integer", "minimum": 0},
    "completed_case_count": {"type": "integer", "minimum": 0},
    "failed_case_count": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["running", "success", "failed", "cancelled", "blocked"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
