--- /dev/null
+++ b/testing/test_bytes_comparison_issue.py
@@ -0,0 +1,17 @@
+from _pytest.assertion.util import assertrepr_compare
+
+
+class DummyConfig:
+    def getoption(self, name):
+        assert name == "verbose"
+        return 0
+
+
+def test_bytes_equality_uses_readable_byte_diff():
+    explanation = assertrepr_compare(DummyConfig(), "==", b"", b"42")
+
+    assert explanation == [
+        "b'' == b'42'",
+        "- '",
+        "+ '42",
+    ]
