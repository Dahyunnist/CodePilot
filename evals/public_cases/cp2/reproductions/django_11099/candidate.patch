@@ -0,0 +1,14 @@
+import unittest
+
+from django.core.exceptions import ValidationError
+from django.contrib.auth.validators import ASCIIUsernameValidator, UnicodeUsernameValidator
+
+
+class UsernameValidatorTrailingNewlineTests(unittest.TestCase):
+    def test_ascii_validator_rejects_trailing_newline(self):
+        with self.assertRaises(ValidationError):
+            ASCIIUsernameValidator()("username\n")
+
+    def test_unicode_validator_rejects_trailing_newline(self):
+        with self.assertRaises(ValidationError):
+            UnicodeUsernameValidator()("username\n")
