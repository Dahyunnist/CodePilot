{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codepilot.local/schemas/cp2-source-provenance-v1.json",
  "title": "CP-2 first-party source provenance",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const":1},
    "evidence_policy": {"type":"string", "minLength":1},
    "tasks": {"type":"array", "minItems":1, "items":{"$ref":"#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type":"object",
      "required":["task_id", "repo", "source_pr_url", "pr_status", "linked_issues", "exact_base_verification"],
      "properties": {
        "task_id":{"type":"string", "minLength":1},
        "repo":{"type":"string", "pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_pr_url":{"type":"string", "format":"uri", "pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$"},
        "pr_status":{"const":"merged"},
        "linked_issues":{"type":"array", "minItems":1, "items":{"$ref":"#/$defs/issue"}},
        "exact_base_verification":{
          "type":"object",
          "required":["status"],
          "properties":{
            "status":{"enum":["pending", "verified"]},
            "image_config_digest":{"type":["string", "null"], "pattern":"^sha256:[a-f0-9]{64}$"},
            "observed_base_commit":{"type":["string", "null"], "pattern":"^[a-f0-9]{40}$"},
            "license_file_at_base":{"type":["string", "null"]},
            "license_file_sha256":{"type":["string", "null"], "pattern":"^[a-f0-9]{64}$"},
            "license":{"type":["string", "null"], "enum":["MIT", "BSD-3-Clause", "Apache-2.0", null]},
            "evidence_path":{"type":["string", "null"]},
            "evidence_sha256":{"type":["string", "null"], "pattern":"^[a-f0-9]{64}$"}
          },
          "oneOf":[
            {"properties":{"status":{"const":"pending"}}},
            {"required":["image_config_digest", "observed_base_commit", "license_file_at_base", "license_file_sha256", "license", "evidence_path", "evidence_sha256"], "properties":{"status":{"const":"verified"}, "image_config_digest":{"type":"string"}, "observed_base_commit":{"type":"string"}, "license_file_at_base":{"type":"string", "minLength":1}, "license_file_sha256":{"type":"string"}, "license":{"enum":["MIT", "BSD-3-Clause", "Apache-2.0"]}, "evidence_path":{"type":"string", "minLength":1}, "evidence_sha256":{"type":"string"}}}
          ]
        }
      }
    },
    "issue": {
      "type":"object",
      "required":["url", "relationship"],
      "properties": {
        "url":{"type":"string", "format":"uri", "pattern":"^https://(github\\.com|code\\.djangoproject\\.com)/"},
        "relationship":{"enum":["fixes", "closes", "supersedes", "possible_closes"]}
      }
    }
  }
}
